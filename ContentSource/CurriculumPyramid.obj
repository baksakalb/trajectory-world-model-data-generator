# Preserve the pyramid's hard geometric edges. Each face has one explicit
# normal, so Unreal must not blend lighting between adjacent faces.
s off

# Square base (outward normal faces downward)
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1

# Four triangular sides
f 1/1/2 2/2/2 5/5/2
f 2/1/3 3/2/3 5/5/3
f 3/1/4 4/2/4 5/5/4
f 4/1/5 1/2/5 5/5/5
